{
  "name": "nightguard-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "backend": ".venv\\Scripts\\python.exe -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "demo": "concurrently -k -n api,web -c magenta,cyan \"npm:backend\" \"npm:dev\"",
    "setup:backend": "python -m venv .venv --system-site-packages && .venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "test:backend": ".venv\\Scripts\\python.exe -m unittest test_demo_pipeline.py",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
